# Copy to .env and fill in. Never commit .env.

# --- Browser (bundled into the public site; safe to expose) ---
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-public-key>

# --- Server/scripts only (NEVER prefix with VITE_, never ship to the browser) ---
# Used by the Phase 3 seed script to upload images and write CMS documents.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# Used to apply migrations from this repo (Settings -> Database -> Connection string, URI).
SUPABASE_DB_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
