{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
      { "key": "Content-Security-Policy", "value": "base-uri 'self'; object-src 'none'; frame-ancestors 'self'" }
    ] }
  ],
  "rewrites": [
    {
      "source": "/news/:path*",
      "destination": "/app"
    },
    {
      "source": "/travel-tours/:path*",
      "destination": "/app"
    },
    {
      "source": "/visa-assistance/:path*",
      "destination": "/app"
    },
    {
      "source": "/philippine-immigration-services/:path*",
      "destination": "/app"
    },
    {
      "source": "/package/:path*",
      "destination": "/app"
    },
    {
      "source": "/dashboard",
      "destination": "/app"
    },
    {
      "source": "/newsletter/:path*",
      "destination": "/app"
    }
  ]
}
