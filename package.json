{
  "name": "air-fair-travel",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:auth": "node --test \"supabase/functions/_shared/auth/*.test.ts\"",
