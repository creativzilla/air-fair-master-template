    "test:security:e2e": "node scripts/test-security-functions.mjs",
    "test:uploads:e2e": "node scripts/test-uploads-e2e.mjs",
    "test:email:e2e": "node scripts/form-function-e2e/run.cjs",
    "test:inbox": "node --test \"supabase/functions/_shared/inbox/*.test.ts\" \"supabase/functions/_shared/campaigns/*.test.ts\"",
    "test:inbox:db": "node scripts/test-email-inbox-db.mjs"
  },
  "dependencies": {
    "@fontsource/poppins": "^5.3.0",
    "@supabase/supabase-js": "^2.45.0",
    "lucide-react": "^0.427.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "7.18.4",
    "sanitize-html": "2.18.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@vitejs/plugin-react": "^4.3.1",
    "postcss": "^8.4.41",
    "tailwindcss": "4.3.3",
    "vite": "6.4.3"
  }
